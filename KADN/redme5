import torch
import timm
from torchvision import transforms
from PIL import Image

EFFNET_CKPT_PATH = "model/best.ckpt"
EFFNET_MODEL_NAME = "tf_efficientnetv2_m"
EFFNET_IMG_SIZE = 384
EFFNET_CROP_SCALE = 1.25

EFFNET_DEVICE = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

_eff_ckpt = torch.load(
    EFFNET_CKPT_PATH,
    map_location="cpu"
)

EFFNET_CLASS_NAMES = [
    str(x) for x in _eff_ckpt["class_names"]
]

GLOBAL_EFFNET = timm.create_model(
    EFFNET_MODEL_NAME,
    pretrained=False,
    num_classes=len(EFFNET_CLASS_NAMES)
)

GLOBAL_EFFNET.load_state_dict(
    _eff_ckpt["model"],
    strict=True
)

GLOBAL_EFFNET.to(EFFNET_DEVICE)
GLOBAL_EFFNET.eval()

EFFNET_TRANSFORM = transforms.Compose([
    transforms.Resize(
        (EFFNET_IMG_SIZE, EFFNET_IMG_SIZE)
    ),
    transforms.ToTensor(),
    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])

print(
    f"EfficientNetV2 initialized: "
    f"{EFFNET_DEVICE}",
    flush=True
)

def expand_bbox(
    self,
    box,
    image_width,
    image_height,
    scale=1.25
):
    x_min, y_min, x_max, y_max = box

    center_x = (x_min + x_max) / 2
    center_y = (y_min + y_max) / 2

    width = (x_max - x_min) * scale
    height = (y_max - y_min) * scale

    new_x_min = max(
        0,
        int(center_x - width / 2)
    )
    new_y_min = max(
        0,
        int(center_y - height / 2)
    )
    new_x_max = min(
        image_width,
        int(center_x + width / 2)
    )
    new_y_max = min(
        image_height,
        int(center_y + height / 2)
    )

    return (
        new_x_min,
        new_y_min,
        new_x_max,
        new_y_max
    )

crop_x_min, crop_y_min, crop_x_max, crop_y_max = (
    self.expand_bbox(
        box,
        image_width,
        image_height,
        EFFNET_CROP_SCALE
    )
)

crop = image[
    crop_y_min:crop_y_max,
    crop_x_min:crop_x_max
]

if crop.size == 0:
    continue

crop_rgb = cv2.cvtColor(
    crop,
    cv2.COLOR_BGR2RGB
)

crop_pil = Image.fromarray(crop_rgb)

eff_input = EFFNET_TRANSFORM(
    crop_pil
).unsqueeze(0).to(EFFNET_DEVICE)

with torch.no_grad():
    eff_logits = GLOBAL_EFFNET(eff_input)
    eff_probs = torch.softmax(
        eff_logits,
        dim=1
    )

eff_score, eff_class_id = torch.max(
    eff_probs,
    dim=1
)

eff_class_id = int(eff_class_id.item())
eff_score = float(eff_score.item())

eff_class_name = EFFNET_CLASS_NAMES[
    eff_class_id
]

print(
    f"YOLOX: class={class_id}, "
    f"score={score:.3f} | "
    f"EffNet: class={eff_class_id}, "
    f"name={eff_class_name}, "
    f"score={eff_score:.3f}",
    flush=True
)

eff_text = (
    f"EffNet: class={eff_class_id} "
    f"score={eff_score:.2f}"
)

cv2.putText(
    out_image,
    eff_text,
    (x_min, min(y_min + 40, image_height - 10)),
    cv2.FONT_HERSHEY_SIMPLEX,
    1.0,
    (0, 255, 255),
    2,
    cv2.LINE_AA
)


def inference_func(self):
    from yolox import postprocess
    from visualization.classes import CLASS_NAME_MAP
    from visualization.visualize_detection import DetectionVisualizer

    engine_path = "model/yolox_tiny_20251205_op18_rtx4060ti_fp16.trt"
    score_threshold = 0.1
    output_shape = (1, 151200, 15)
    trt_inferencer = None

    try:
        visualizer = DetectionVisualizer()

        while True:
            if not self.capture_image_queue.empty():
                while not self.capture_image_queue.empty():
                    image = self.capture_image_queue.get()
            else:
                image = self.capture_image_queue.get()

            if image is None:
                break

            image_height, image_width, _ = image.shape
            input_image = image.transpose(2, 0, 1)

            detected_info = self.trt_inferencer.infer(
                inputs=input_image,
                output_shape=output_shape
            )

            boxes, scores, class_ids = postprocess.get_detection_result(
                inference_output=detected_info,
                input_shape=(image_height, image_width),
                ratio=1
            )

            out_image = image.copy()

            for i in range(len(boxes)):
                box = boxes[i]
                score = scores[i]
                class_id = int(class_ids[i])

                if score < score_threshold:
                    continue

                if self.param["detection_mode"] == "yolox_effnetv2":
                    crop_x_min, crop_y_min, crop_x_max, crop_y_max = (
                        self.expand_bbox(
                            box,
                            image_width,
                            image_height,
                            EFFNET_CROP_SCALE
                        )
                    )

                    crop = image[
                        crop_y_min:crop_y_max,
                        crop_x_min:crop_x_max
                    ]

                    if crop.size == 0:
                        continue

                    crop_rgb = cv2.cvtColor(
                        crop,
                        cv2.COLOR_BGR2RGB
                    )

                    crop_pil = Image.fromarray(crop_rgb)

                    eff_input = EFFNET_TRANSFORM(
                        crop_pil
                    ).unsqueeze(0).to(EFFNET_DEVICE)

                    with torch.no_grad():
                        eff_logits = GLOBAL_EFFNET(eff_input)
                        eff_probs = torch.softmax(
                            eff_logits,
                            dim=1
                        )

                    eff_score, eff_class_id = torch.max(
                        eff_probs,
                        dim=1
                    )

                    eff_class_id = int(eff_class_id.item())
                    eff_score = float(eff_score.item())

                    eff_class_name = EFFNET_CLASS_NAMES[
                        eff_class_id
                    ]

                    print(
                        f"YOLOX: class={class_id}, "
                        f"score={score:.3f} | "
                        f"EffNet: class={eff_class_id}, "
                        f"name={eff_class_name}, "
                        f"score={eff_score:.3f}",
                        flush=True
                    )

                x_min = round(box[0])
                y_min = round(box[1])
                x_max = round(box[2])
                y_max = round(box[3])

                visualizer.overlay_boxes(
                    image=out_image,
                    left_top=(x_min, y_min),
                    right_bottom=(x_max, y_max),
                    score=score,
                    class_id=class_id,
                    class_name_map=CLASS_NAME_MAP,
                )

                if self.param["detection_mode"] == "yolox_effnetv2":
                    eff_text = (
                        f"EffNet: class={eff_class_id} "
                        f"score={eff_score:.2f}"
                    )

                    cv2.putText(
                        out_image,
                        eff_text,
                        (
                            x_min,
                            min(
                                y_min + 40,
                                image_height - 10
                            )
                        ),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        1.0,
                        (0, 255, 255),
                        2,
                        cv2.LINE_AA
                    )

            self.output_image_queue.put(out_image)

    except Exception as e:
        print(
            f"予期しないエラーが発生しました:\n{e}"
        )

    finally:
        if trt_inferencer is not None:
            trt_inferencer.destroy()

    return