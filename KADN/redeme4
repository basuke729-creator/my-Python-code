def inference_func(self):
    # from trt.tensorrt_inferencer import TensorRTInferencer
    from yolox import postprocess
    from visualization.classes import CLASS_NAME_MAP
    from visualization.visualize_detection import DetectionVisualizer

    engine_path = "model/yolox_tiny_20251205_op18_rtx4060ti_fp16.trt"
    score_threshold = 0.1
    output_shape = (1, 151200, 15)
    trt_inferencer = None

    # ===== テスト用動画保存処理 追加開始 =====
    output_video_path = "output/unsafe_act_monitoring_test.mp4"
    output_video_fps = 29.97
    video_writer = None

    os.makedirs(
        os.path.dirname(output_video_path),
        exist_ok=True
    )
    # ===== テスト用動画保存処理 追加終了 =====

    try:
        # trt_inferencer = TensorRTInferencer(engine_path)
        visualizer = DetectionVisualizer()

        while True:
            if not self.capture_image_queue.empty():
                while not self.capture_image_queue.empty():
                    image = self.capture_image_queue.get()
            else:
                image = self.capture_image_queue.get()

            if image is None:
                break

            image_height, image_width, _ = image.shape
            input_image = image.transpose(2, 0, 1)

            detected_info = self.trt_inferencer.infer(
                inputs=input_image,
                output_shape=output_shape
            )

            boxes, scores, class_ids = postprocess.get_detection_result(
                inference_output=detected_info,
                input_shape=(image_height, image_width),
                ratio=1
            )

            out_image = image.copy()

            for i in range(len(boxes)):
                box = boxes[i]
                score = scores[i]
                class_id = int(class_ids[i])

                if score < score_threshold:
                    continue

                x_min = round(box[0])
                y_min = round(box[1])
                x_max = round(box[2])
                y_max = round(box[3])

                visualizer.overlay_boxes(
                    image=out_image,
                    left_top=(x_min, y_min),
                    right_bottom=(x_max, y_max),
                    score=score,
                    class_id=class_id,
                    class_name_map=CLASS_NAME_MAP,
                )

            # ===== テスト用動画保存処理 追加開始 =====
            if video_writer is None:
                output_height, output_width = out_image.shape[:2]

                fourcc = cv2.VideoWriter_fourcc(*"mp4v")

                video_writer = cv2.VideoWriter(
                    output_video_path,
                    fourcc,
                    output_video_fps,
                    (output_width, output_height)
                )

                if not video_writer.isOpened():
                    raise RuntimeError(
                        "テスト動画保存用のVideoWriterを"
                        "初期化できませんでした"
                    )

                print(
                    f"テスト動画の保存を開始します: "
                    f"{output_video_path}",
                    flush=True
                )

            video_writer.write(out_image)
            # ===== テスト用動画保存処理 追加終了 =====

            self.output_image_queue.put(out_image)

    except Exception as e:
        print(f"予期しないエラーが発生しました:\n{e}")

    finally:
        # ===== テスト用動画保存処理 追加開始 =====
        if video_writer is not None:
            video_writer.release()
            print(
                f"テスト動画を保存しました: "
                f"{output_video_path}",
                flush=True
            )
        # ===== テスト用動画保存処理 追加終了 =====

        if trt_inferencer is not None:
            trt_inferencer.destroy()

    return