def destroy(self):
    self.cfx.push()

    try:
        self.inputs.clear()
        self.outputs.clear()
        self.bindings.clear()

        del self.context
        del self.engine
        del self.runtime
        del self.stream

    finally:
        self.cfx.pop()
        self.cfx.detach()

